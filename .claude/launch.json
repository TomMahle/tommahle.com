{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "pnpm --filter @tommahle/mobile exec expo start --web --port ${PORT:-8081}"
      ],
      "port": 8081
    }
  ]
}
